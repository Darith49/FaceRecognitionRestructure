# ==============================================================================
# Docker Build Ignore File (.dockerignore)
# Excludes unnecessary files to keep image build fast, small, and secure.
# ==============================================================================

# Version Control
.git/
.gitignore

# Python Bytecode & Cache
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# Virtual Environments
env/
venv/
.venv/
ENV/
env.bak/
venv.bak/

# Environment & Secrets (NEVER bake into image)
.env
*.env
*.json
!requirements.txt

# Database & Persistent Data (Mounted via volumes instead)
*.sqlite3
*.sqlite3-journal
*.sqlite3-wal
*.sqlite3-shm
data/
db.sqlite3

# Uploaded Media & Generated Static Files
media/
staticfiles/

# Model Caches
.deepface/

# IDE & Editor Configurations
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store

# Testing, Linting & Build Artifacts
.pytest_cache/
.coverage
htmlcov/
build/
dist/
*.egg-info/
