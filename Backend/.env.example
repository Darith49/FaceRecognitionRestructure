# ==============================================================================
# Django Configuration
# ==============================================================================
SECRET_KEY=django-insecure-face-attendance-mvp-secret-key-2026
DEBUG=True
ALLOWED_HOSTS=*
CSRF_TRUSTED_ORIGINS=https://*.trycloudflare.com,http://localhost:8000,http://127.0.0.1:8000

# ==============================================================================
# Server & Docker Container Configuration
# ==============================================================================
PORT=8000
GUNICORN_WORKERS=3
GUNICORN_TIMEOUT=120

# ==============================================================================
# Database Configuration (SQLite)
# ==============================================================================
# For host/local execution: db.sqlite3 or data/db.sqlite3
# For Docker container execution: /app/data/db.sqlite3
SQLITE_DB_PATH=data/db.sqlite3

# ==============================================================================
# DeepFace Pretrained Model Cache
# ==============================================================================
DEEPFACE_HOME=/app/.deepface

# ==============================================================================
# Firebase Configuration
# ==============================================================================
# Path to service account JSON (e.g. face-recognition-attenda-230d3-firebase-adminsdk-fbsvc-255c00d255.json)
FIREBASE_CREDENTIALS_PATH=face-recognition-attenda-230d3-firebase-adminsdk-fbsvc-255c00d255.json
FIREBASE_PROJECT_ID=face-recognition-attenda-230d3
